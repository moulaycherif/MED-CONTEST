{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": false,
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "types": ["node"],   // 🔥 AJOUT ICI
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
